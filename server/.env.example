# z-proxy 服务端配置模板
# 部署：cp .env.example .env 后填写真实值（.env 不进 git）
#
# ── 转发面 ──
# 监听端口 / 地址
PORT=8443
HOST=0.0.0.0
# 转发密钥：必须与所有客户端 config 里的 token 一致
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 生产启动要求至少 24 字符；此占位符不可直接启动
PROXY_TOKEN=change-me
# 空闲超时（秒），0 = 关闭，默认 300
IDLE_TIMEOUT=300
HANDSHAKE_TIMEOUT_MS=10000
DNS_TIMEOUT_MS=5000
CONNECT_TIMEOUT_MS=10000
SETUP_TIMEOUT_MS=30000
HTTP_TIMEOUT_MS=60000
MAX_CONNECTIONS=1024
#
# ── 管理面（Web 管理台）──
ADMIN_PASSWORD=change-me
ADMIN_ENABLED=1
ADMIN_PORT=9090
ADMIN_HOST=127.0.0.1
# 管理密码要求至少 12 字符。纯本地测试可明确设置 ALLOW_INSECURE_DEV=1，
# 此时 HOST/ADMIN_HOST 必须是回环地址。不要在生产启用。
